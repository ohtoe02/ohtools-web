{
  "name": "ohtools-web",
  "description": "Verified documentation and plugin catalog for ohtools.",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.11 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm sync:catalog && pnpm sync:plugin-docs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm sync:catalog && pnpm sync:plugin-docs && astro check",
    "format:check": "prettier --check .",
    "sync:catalog": "tsx scripts/sync-catalog.ts",
    "sync:plugin-docs": "tsx scripts/sync-plugin-docs.ts",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm astro build",
    "release:check": "tsx scripts/check-release-readiness.ts",
    "check:routes": "tsx scripts/check-built-routes.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/starlight": "^0.41.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.0.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
