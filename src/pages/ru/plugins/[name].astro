---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PluginDetail from "../../../components/PluginDetail.astro";
import catalogData from "../../../generated/catalog.json";
import pluginDocsData from "../../../generated/plugin-docs.json";
import type { CatalogPluginView } from "../../../lib/catalog/catalog";
import type { VerifiedPluginDocumentation } from "../../../lib/plugin-docs/plugin-docs";

export function getStaticPaths() {
  return (catalogData.plugins as CatalogPluginView[]).map((plugin) => ({
    params: { name: plugin.name },
    props: {
      plugin,
      documentation: (pluginDocsData as VerifiedPluginDocumentation).plugins[
        plugin.name
      ],
      sourceCommit: (pluginDocsData as VerifiedPluginDocumentation)
        .sourceCommit,
    },
  }));
}

const { plugin, documentation, sourceCommit } = Astro.props as {
  plugin: CatalogPluginView;
  documentation: VerifiedPluginDocumentation["plugins"][string];
  sourceCommit: string;
};
---

<StarlightPage
  frontmatter={{
    title: plugin.name,
    description: plugin.description,
    template: "splash",
    pagefind: true,
  }}
>
  <PluginDetail
    locale="ru"
    plugin={plugin}
    documentation={documentation}
    sourceCommit={sourceCommit}
  />
</StarlightPage>
