---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CatalogView from '../../components/CatalogView.astro';
import catalogData from '../../generated/catalog.json';
import type { CatalogPluginView } from '../../lib/catalog/catalog';
---

<StarlightPage
	frontmatter={{
		title: 'Verified plugin catalog',
		description: 'Browse installable plugins from the signed ohtools catalog.',
		template: 'splash',
		pagefind: true,
	}}
>
	<CatalogView
		locale="en"
		plugins={catalogData.plugins as CatalogPluginView[]}
		state={catalogData.state}
	/>
</StarlightPage>
