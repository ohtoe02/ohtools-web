---
import type { TerminalLocale } from "../lib/terminal/commands";

interface Props {
  locale: TerminalLocale;
  pluginCount: number;
  moduleCount: number;
  sequence: number;
  verifiedKey: string;
}

const { locale, pluginCount, moduleCount, sequence, verifiedKey } = Astro.props;
const isRussian = locale === "ru";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localePrefix = isRussian ? "/ru" : "";
const path = (value: string) => `${base}${localePrefix}${value}`;
---

<section
  class="terminal-session"
  data-terminal-session
  data-locale={locale}
  data-base={base}
  aria-label={isRussian ? "Навигационный терминал" : "Navigation terminal"}
>
  <header class="terminal-session-bar">
    <span>session: portal</span>
    <span class="terminal-session-state">
      <span class="status-dot" aria-hidden="true"></span>
      verified / seq {sequence}
    </span>
  </header>

  <div
    class="terminal-transcript"
    data-terminal-output
    role="log"
    aria-live="polite"
    aria-relevant="additions"
  >
    <div class="terminal-entry">
      <div class="terminal-command">
        <span class="terminal-prompt-mark" aria-hidden="true">$</span>
        <span>ohtools portal status</span>
      </div>
      <div class="terminal-output">
        <span>status&nbsp;&nbsp;&nbsp; verified</span>
        <span>plugins&nbsp;&nbsp; {pluginCount}</span>
        <span>modules&nbsp;&nbsp; {moduleCount}</span>
        <span>key&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; {verifiedKey}</span>
      </div>
    </div>
  </div>

  <nav
    class="terminal-shortcuts"
    aria-label={isRussian ? "Быстрые команды" : "Quick commands"}
  >
    <span>{isRussian ? "быстрый запуск:" : "quick start:"}</span>
    <a href={path("/docs/")}>docs</a>
    <a href={path("/plugins/")}>plugins</a>
    <a href={path("/declarative/")}>modules</a>
  </nav>

  <form class="terminal-input-row" data-terminal-form>
    <label class="sr-only" for={`terminal-command-${locale}`}>
      {isRussian ? "Команда терминала" : "Terminal command"}
    </label>
    <span class="terminal-prompt-mark" aria-hidden="true">$</span>
    <input
      id={`terminal-command-${locale}`}
      name="command"
      type="text"
      maxlength="80"
      autocomplete="off"
      autocapitalize="none"
      spellcheck="false"
      aria-label={isRussian ? "Команда терминала" : "Terminal command"}
      placeholder={isRussian ? 'введите "help"' : 'type "help"'}
    />
    <span class="terminal-cursor" aria-hidden="true"></span>
  </form>
</section>

<script>
  import {
    parseTerminalCommand,
    type TerminalLocale,
  } from "../lib/terminal/commands";

  function appendOutput(
    root: HTMLElement,
    command: string,
    lines: string[],
    tone: "normal" | "error" = "normal",
  ): void {
    const transcript = root.querySelector("[data-terminal-output]");
    if (!(transcript instanceof HTMLElement)) return;

    const entry = document.createElement("div");
    entry.className = "terminal-entry";

    const commandLine = document.createElement("div");
    commandLine.className = "terminal-command";
    const mark = document.createElement("span");
    mark.className = "terminal-prompt-mark";
    mark.setAttribute("aria-hidden", "true");
    mark.textContent = "$";
    const commandText = document.createElement("span");
    commandText.textContent = command;
    commandLine.append(mark, commandText);

    const output = document.createElement("div");
    output.className =
      tone === "error" ? "terminal-output is-error" : "terminal-output";
    for (const line of lines) {
      const row = document.createElement("span");
      row.textContent = line;
      output.append(row);
    }

    entry.append(commandLine, output);
    transcript.append(entry);
    entry.scrollIntoView({ block: "nearest" });
  }

  for (const root of document.querySelectorAll("[data-terminal-session]")) {
    if (!(root instanceof HTMLElement)) continue;
    const form = root.querySelector("[data-terminal-form]");
    const input = form?.querySelector('input[name="command"]');
    if (
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLInputElement)
    )
      continue;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const command = input.value;
      const locale: TerminalLocale = root.dataset.locale === "ru" ? "ru" : "en";
      const result = parseTerminalCommand(command, {
        base: root.dataset.base ?? "/",
        locale,
      });
      input.value = "";

      if (result.kind === "noop") return;
      if (result.kind === "clear") {
        root.querySelector("[data-terminal-output]")?.replaceChildren();
        return;
      }
      if (result.kind === "navigate") {
        window.location.assign(result.href);
        return;
      }
      if (result.kind === "theme") {
        const picker = document.querySelector("starlight-theme-select select");
        if (picker instanceof HTMLSelectElement) {
          picker.value = result.theme;
          picker.dispatchEvent(new Event("change", { bubbles: true }));
        }
        appendOutput(root, command, [result.message]);
        return;
      }
      appendOutput(root, command, result.lines, result.tone);
    });
  }
</script>
