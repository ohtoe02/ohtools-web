---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathWithoutBase =
  base && Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length)
    : Astro.url.pathname;
const displayPath = pathWithoutBase.replace(/\/+$/, "") || "/";
const isPortalHome = displayPath === "/" || displayPath === "/ru";
---

{
  isPortalHome ? (
    <h1 id="_top" class="sr-only">
      {Astro.locals.starlightRoute.entry.data.title}
    </h1>
  ) : (
    <>
      <div class="shell-page-title" data-shell-page-title>
        <span aria-hidden="true">$ </span>
        <span>view {displayPath}</span>
      </div>
      <h1 id="_top">{Astro.locals.starlightRoute.entry.data.title}</h1>
    </>
  )
}
